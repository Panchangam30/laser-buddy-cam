
OPENAI_API_KEY=sk-your-key-here

OPENAI_MODEL=gpt-4o


IMAGE_DETAIL=high


CAMERA_INDEX=0

# --- Voice output (xAI Grok TTS) ---
# Optional. Without this, answers are shown on screen but not spoken.
# Get one at https://console.x.ai
XAI_API_KEY=

# Voice to speak with. Run `.venv/bin/python identify.py --voices` for the list.
XAI_VOICE_ID=atlas

# Set to 0 to disable speech without removing the key.
SPEAK=1

# Speech pace, 0.7-1.5. Slightly above 1.0 keeps answers snappy.
TTS_SPEED=1.1

# --- Live voice conversation ---
# Which provider runs the realtime voice session: grok | openai
VOICE_PROVIDER=grok

# Grok voice model. XAI_VOICE_ID above also sets the speaking voice.
GROK_VOICE_MODEL=grok-voice-latest

# --- Board vision service (OpenCV) ---
# Locates the breadboard and every part on it, and maps each to the hole it
# sits in. Started automatically by `npm run dev` in web/.
VISION_PORT=8788

# Where the Node API looks for it. Change only if you run it elsewhere.
VISION_URL=http://127.0.0.1:8788
